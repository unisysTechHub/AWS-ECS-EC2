        <mxCell id="title" value="fundtransfer-dev | Terraform-provisioned ECS on EC2 architecture (us-east-1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="35" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid arrows: runtime traffic / association&lt;br&gt;Dashed arrows: image, logs, DNS, or control-plane dependency&lt;br&gt;Dashed-border groups expand Terraform module resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#879196;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1500" y="18" width="470" height="70" as="geometry"/></mxCell>

        <mxCell id="internet" value="Internet clients" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="115" height="65" as="geometry"/></mxCell>
        <mxCell id="ecr" value="&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;fundtransfer-dev/userservice&lt;br&gt;accountservice · transactionservice&lt;br&gt;coordinatorservice · authservice&lt;br&gt;&lt;i&gt;immutable tags; scan on push&lt;/i&gt;" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_container_registry;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="235" height="110" as="geometry"/></mxCell>

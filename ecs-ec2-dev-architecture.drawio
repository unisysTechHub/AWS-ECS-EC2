        <mxCell id="iam" value="&lt;b&gt;IAM&lt;/b&gt;&lt;br&gt;Task execution role + AmazonECSTaskExecutionRolePolicy&lt;br&gt;EC2 instance role + AmazonEC2ContainerServiceforEC2Role&lt;br&gt;EC2 instance profile" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="260" height="105" as="geometry"/></mxCell>


        <mxCell id="asg" value="&lt;b&gt;Auto Scaling Group: fundtransfer-dev-ecs&lt;/b&gt;&lt;br&gt;min 2 · desired 2 · max 4&lt;br&gt;Launch template: m5.xlarge + ECS AMI + EC2 SG&lt;br&gt;ECS capacity provider (managed scaling: 80%)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.auto_scaling;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="privatea"><mxGeometry x="20" y="52" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="ec2sg" value="EC2 ECS security group&lt;br&gt;self: all | egress: all&lt;br&gt;SSH :22 from configured CIDR" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_group;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=6;fontSize=11;" vertex="1" parent="privatea"><mxGeometry x="375" y="60" width="170" height="82" as="geometry"/></mxCell>
        <mxCell id="ec2" value="ECS container instances&lt;br&gt;(EC2 instances across private subnets)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="privateb"><mxGeometry x="25" y="58" width="250" height="65" as="geometry"/></mxCell>

        <mxCell id="cluster" value="&lt;b&gt;Amazon ECS cluster: fundtransfer-dev&lt;/b&gt;&lt;br&gt;EC2 launch type | Container Insights enabled&lt;br&gt;Default capacity provider: fundtransfer-dev-ec2" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_container_service;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=8;fontStyle=1;" vertex="1" parent="vpc"><mxGeometry x="1000" y="135" width="430" height="75" as="geometry"/></mxCell>

        <mxCell id="cloudmap" value="&lt;b&gt;AWS Cloud Map private DNS namespace&lt;/b&gt;&lt;br&gt;dev.local (VPC-associated)&lt;br&gt;A records, MULTIVALUE routing, TTL 10 sec&lt;br&gt;Service discovery services: mysql, redis, kafka, userservice, accountservice, transactionservice, coordinatorservice, authservice" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloud_map;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="vpc"><mxGeometry x="875" y="245" width="650" height="105" as="geometry"/></mxCell>
